# Apenas exemplos sem credenciais. Variáveis serão implementadas junto com o código.
API_HOST=127.0.0.1
API_PORT=8000
STREAMLIT_PORT=8501
PAGECHECK_API_URL=http://127.0.0.1:8000
AUDIT_MAX_CONCURRENT=1
AUDIT_TIMEOUT_SECONDS=60
ENABLE_IMPECCABLE=false
# Não habilitar bypass de SSRF em ambientes públicos.
ALLOW_LOCAL_TEST_FIXTURES=false
