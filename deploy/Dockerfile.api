# Page Check internal FastAPI service. NEVER expose this Dockerfile as a public
# Render web service without a separate scanner security review.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /uvx /usr/local/bin/
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
RUN uv sync --frozen --no-dev --no-editable

# Runtime Playwright is currently missing from the project's uv.lock. Keep
# this pinned and isolated to the API container. Reconcile it into uv.lock
# before a production release; never use an unpinned moving 'latest'.
RUN uv pip install --python /app/.venv/bin/python playwright==1.57.0 && \
    python -m playwright install --with-deps chromium

COPY main.py ./
COPY migrations/ ./migrations/
COPY scripts/postgres_temporary_migrate.py ./scripts/postgres_temporary_migrate.py
RUN useradd --system --home-dir /app --shell /usr/sbin/nologin pagecheck && \
    mkdir -p /app/artifacts && chown -R pagecheck:pagecheck /app
USER pagecheck
EXPOSE 10000
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000", "--workers", "1"]
