# STAGE36: compile the syscall guard in an isolated build stage. Keep C build
# tools out of the production API image.
FROM debian:bookworm-slim AS seccomp-build
RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && \
    rm -rf /var/lib/apt/lists/*
COPY deploy/browser_no_net.c /tmp/browser_no_net.c
RUN cc -std=c11 -O2 -Wall -Wextra -Werror /tmp/browser_no_net.c \
        -o /usr/local/bin/pagecheck-chromium-sandbox && \
    /usr/local/bin/pagecheck-chromium-sandbox --self-test

# Build-time only: copy the bounded axe script and Impeccable native detector
# into the runtime image without shipping Node.js or Lighthouse's network Chrome.
FROM node:22-bookworm-slim AS engine-assets
WORKDIR /engines
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Page Check internal FastAPI service. NEVER expose this Dockerfile as a public
# Render web service without a separate scanner security review.
FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PATH="/app/.venv/bin:$PATH" \
    PAGECHECK_BROWSER_SECCOMP_LAUNCHER=/usr/local/bin/pagecheck-chromium-sandbox
COPY --from=seccomp-build /usr/local/bin/pagecheck-chromium-sandbox /usr/local/bin/pagecheck-chromium-sandbox
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /uvx /usr/local/bin/
COPY pyproject.toml uv.lock README.md ./
COPY src/ ./src/
RUN uv sync --locked --no-dev --no-editable

RUN mkdir -p /app/node_modules/axe-core /app/node_modules/.bin
COPY --from=engine-assets /engines/node_modules/axe-core/axe.min.js /app/node_modules/axe-core/axe.min.js
COPY --from=engine-assets /engines/node_modules/@impeccable/cli-linux-x64/bin/impeccable /app/node_modules/.bin/impeccable
RUN chmod 0555 /app/node_modules/.bin/impeccable && \
    test -s /app/node_modules/axe-core/axe.min.js

# Runtime Playwright is currently missing from the project's uv.lock. Keep
# this pinned and isolated to the API container. Reconcile it into uv.lock
# before a production release; never use an unpinned moving 'latest'.
RUN uv pip install --python /app/.venv/bin/python playwright==1.57.0 && \
    python -m playwright install --with-deps chromium && \
    python -c "from bs4 import BeautifulSoup; from PIL import Image; from playwright.sync_api import sync_playwright; from pagecheck.api.app import app; print('API_RUNTIME_IMPORTS_OK')"

COPY main.py ./
COPY migrations/ ./migrations/
COPY scripts/postgres_temporary_migrate.py ./scripts/postgres_temporary_migrate.py
COPY scripts/postgres_temporary_cleanup.py ./scripts/postgres_temporary_cleanup.py
COPY deploy/start_api_render_free.sh ./deploy/start_api_render_free.sh
RUN useradd --system --home-dir /app --shell /usr/sbin/nologin pagecheck && \
    mkdir -p /app/artifacts && chown -R pagecheck:pagecheck /app
USER pagecheck
EXPOSE 10000
CMD ["/app/.venv/bin/uvicorn", "main:app", "--host", "0.0.0.0", "--port", "10000", "--workers", "1"]
